# NBU-SuperAssistant's settings on the host. Copy to .env.production, fill it
# in, and keep it private:
#
#   cp .env.production.example .env.production
#   chmod 600 .env.production
#   nano .env.production
#
# Read by the service and the reminder timer through EnvironmentFile, and by
# `python -m superassistant <command>` itself, which never overrides a
# variable already set. Not a shell script: one KEY=VALUE per line, comments
# only on lines of their own starting with #, no quotes around values, no
# export, no $VARIABLES. A comment after a value would become part of it.
#
# NBU-SuperAssistant refuses to start, naming the setting, when one of these
# is wrong; see docs/deployment.md, "If it will not start". .env.production
# is never committed (.gitignore).

# The address people reach NBU-SuperAssistant on: just the scheme and the
# host, no path, query or #. Every link in a message is built from it. A host
# other than localhost, 127.0.0.1 or ::1 makes this a hosted installation,
# which must be https. For the very first start, before the owner's account
# exists, write http://127.0.0.1:8791 here instead (docs/deployment.md,
# "The owner's account, before the address is public").
SUPERASSISTANT_BASE_URL=https://nbu-superassistant.visiometrica.com

# Where the records are kept: the database, the lists, the generated reports
# and the session key. Required when hosted, and refused inside the clone, so
# that pulling or cloning the code again can never touch them. Create it
# first, with mkdir -p and chmod 700.
SUPERASSISTANT_DATA_DIR=/home/victor/nbu-superassistant-data

# The username of the owner's staff account. The account it names is the
# owner, with no approval, so leave this empty for the very first start,
# register the account while the service answers only on this machine, then
# write its username here and restart (docs/deployment.md, "The owner's
# account, before the address is public").
SUPERASSISTANT_OWNER_USERNAME=

# --- Mail ------------------------------------------------------------------
#
# send: every message goes to its intended recipient through the relay
# below. Required when hosted: with console, students' sign-in links would
# only be printed. (owner: every message goes to SUPERASSISTANT_OWNER_EMAIL,
# with the intended recipient written at its top. console, or unset: printed,
# never sent.) Prove the relay before anything depends on it:
#   .venv/bin/python -m superassistant mail-test you@example.com
SUPERASSISTANT_MAIL_MODE=send

# The sender: messages come from "NBU-SuperAssistant <this address>". Its
# domain must be verified in the Resend account.
SUPERASSISTANT_MAIL_FROM=nbu-superassistant@visiometrica.com

# Only for mail mode owner: the address every message goes to instead. Leave
# it empty with send.
SUPERASSISTANT_OWNER_EMAIL=

# Resend's SMTP relay.
SUPERASSISTANT_SMTP_HOST=smtp.resend.com
SUPERASSISTANT_SMTP_USERNAME=resend
# The Resend key, the one CourseBench's own .env.production holds. Never
# committed, and never typed here by hand: docs/deployment.md, "First
# install", copies it in with a command that never prints it.
SUPERASSISTANT_SMTP_PASSWORD=

# Optional. The relay's port: 587 for starttls (the default), 465 for ssl,
# 25 for none.
# SUPERASSISTANT_SMTP_PORT=587
# Optional. How the connection to the relay is secured: starttls (the
# default), ssl or none.
# SUPERASSISTANT_SMTP_SECURITY=starttls
# Optional. The name NBU-SuperAssistant greets the relay with. The default is
# this machine's hostname; set it only if the relay refuses that.
# SUPERASSISTANT_SMTP_EHLO=

# --- Behind the tunnel -----------------------------------------------------
#
# The request header that names the real visitor, for the limits on how much
# mail one visitor may ask for. The tunnel connects from 127.0.0.1, so
# without this every visitor looks like this machine. Never set it on an
# installation reachable other than through the tunnel: there, anyone could
# write the header and be a new visitor on every request.
SUPERASSISTANT_CLIENT_IP_HEADER=CF-Connecting-IP

# --- Reminders -------------------------------------------------------------
#
# The timer runs `python -m superassistant remind` at 09:00 Sofia time. A
# supervisor who has not answered is reminded once this many calendar days
# (Sofia dates) have passed since the request or its latest reminder...
# SUPERASSISTANT_REMINDER_DAYS=3
# ...and at most this many times.
# SUPERASSISTANT_REMINDER_COUNT=2

# --- The session key -------------------------------------------------------
#
# Leave unset. The key that signs sign-in cookies and the links in
# supervisors' requests and reminders is made once, on the first start, and
# kept in the records folder (the file secret_key), where the service, the
# timer and the host commands all find it. Setting or changing it later
# signs everybody out, and the reminders of requests already sent would carry
# links that no longer work.
# SUPERASSISTANT_SECRET_KEY=
